{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "short_name": "Lanterna",
  "description": "__MSG_description__",
  "version": "1.1.11.7",
  "version_name": "1.1.11b8",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "key": "",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "__MSG_open__", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["sidePanel", "tabs", "tabGroups", "scripting", "storage", "alarms", "debugger", "downloads",
                  "contextMenus", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+L" }, "description": "__MSG_open__" }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src http://127.0.0.1:*"
  }
}
